# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Entregas Unicas - somente servidor
# Gere 32 bytes aleatorios: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca use prefixo NEXT_PUBLIC_ nesta chave.
UNIQUE_DELIVERY_ENCRYPTION_KEY=base64-key-with-exactly-32-random-bytes

# Pagar.me
PAGARME_API_KEY=your-pagarme-api-key
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=your-pagarme-public-key
PAGARME_PUBLIC_KEY=your-pagarme-public-key
ENABLE_CREDIT_CARD=true

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Domínios personalizados das lojas via Cloudflare for SaaS - somente servidor
# Token limitado à zona, com Zone > SSL and Certificates > Edit.
# Nunca use prefixo NEXT_PUBLIC_ no token ou no segredo.
CUSTOM_DOMAINS_CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CUSTOM_DOMAINS_CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CUSTOM_DOMAINS_CLOUDFLARE_CNAME_TARGET=lojas.goupay.com.br
# Mesmo segredo configurado no Worker como EDGE_SHARED_SECRET.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CUSTOM_DOMAINS_EDGE_SECRET=shared-random-secret
# Domínios oficiais da plataforma, separados por vírgula. Eles nunca serão tratados como lojas.
PLATFORM_HOSTNAMES=goupay.com.br,www.goupay.com.br

# Transactional Email - GoDaddy Professional Email / Titan
# Use the password of the real mailbox configured in GoDaddy.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@your-domain.com
SMTP_PASS=your-mailbox-password
SMTP_FROM=GouPay <contato@your-domain.com>
API_PIX_PENDING_EMAIL_ENABLED=true

# Optional email recipients
SUPPORT_EMAIL=support@your-domain.com
ACCOUNT_DELETION_EMAIL=support@your-domain.com

# Platform Configuration
NEXT_PUBLIC_PLATFORM_FEE_PERCENTAGE=10
PLATFORM_RECIPIENT_ID=your-platform-recipient-id

# Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com
